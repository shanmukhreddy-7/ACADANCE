# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Add this variable in Vercel Project Settings for deployment.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional shared storage on Vercel. Local mode uses encrypted app/data instead.
# Use the same SESSION_SECRET permanently; losing it makes stored records unreadable.
# MONGO_URI=mongodb+srv://...
# ADMIN_REGISTRATIONS=AP00000000001,AP00000000002
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_BUCKET=your-private-bucket
# B2_KEY_ID=your-key-id
# B2_APP_KEY=your-application-key
# CRON_SECRET=another-random-secret-at-least-32-characters
